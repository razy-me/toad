>bgPaper = #eff2f5;
>inkBlue = #1a3258;

canvas "Test-Kamekura" {
    size: 1000px 1400px;
    background: >bgPaper;
    export: all;
}

rect #frameBorder {
    size: 920px 1156px;
    fill: transparent;
    stroke: >inkBlue 1.5px;
    at: (40px, 40px);
}

text #title {
    content: "東京オリンピックの公式ポスタ (亀倉 雄策)";
    font-family: "Yu Gothic";
    font-size: 30px;
    font-weight: bold;
    color: >inkBlue;
    at: (42px, 1272px);
}

circle #logoCircle {
    size: 58px;
    fill: >inkBlue;
    at: (828px, 1256px);
}
