// 01_ui_kit_components.toad
// Complete, runnable Design System UI Kit showcasing reusable components,
// parametric props, auto-layout stacks, and modern glassmorphic surfaces.

// -------------------------------------------------------------
// 1. DESIGN TOKENS
// -------------------------------------------------------------
>primary = #3b82f6;
>primaryHover = #2563eb;
>accent = #10b981;
>warning = #f59e0b;
>danger = #ef4444;

>bgDark = #0f172a;
>cardSurface = #1e293b;
>cardSurfaceLight = #334155;
>borderSubtle = #47556940;

>textLight = #f8fafc;
>textMuted = #94a3b8;

>radiusSm = 6px;
>radiusMd = 12px;
>radiusLg = 16px;
>radiusFull = 9999px;

>fontFamily = "Inter, -apple-system, sans-serif";

// -------------------------------------------------------------
// 2. REUSABLE COMPONENTS
// -------------------------------------------------------------

// Parametric Pill Badge with 20% horizontal safety padding
component StatusBadge(label = "Active", bg = #10b981, textColor = #ffffff) {
  group {
    rect {
      size: 110px 32px;
      fill: >bg;
      border-radius: >radiusFull;
    }
    text {
      content: >label;
      at: center of parent;
      font-family: >fontFamily;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.5px;
      color: >textColor;
    }
  }
}

// Interactive Primary Button
component PrimaryButton(label = "Get Started", width = 160px, height = 48px) {
  group {
    rect {
      size: >width >height;
      fill: linear-gradient(135deg, #3b82f6, #2563eb);
      border-radius: >radiusMd;
      shadow: 0 8px 20px #3b82f640;
    }
    text {
      content: >label;
      at: center of parent;
      font-family: >fontFamily;
      font-size: 15px;
      font-weight: 600;
      color: #ffffff;
    }
  }
}

// Outline Secondary Button
component SecondaryButton(label = "Learn More", width = 160px, height = 48px) {
  group {
    rect {
      size: >width >height;
      fill: transparent;
      stroke: #64748b 1px solid;
      border-radius: >radiusMd;
    }
    text {
      content: >label;
      at: center of parent;
      font-family: >fontFamily;
      font-size: 15px;
      font-weight: 600;
      color: >textLight;
    }
  }
}

// Metric Stat Card
component MetricCard(title = "Active Users", value = "24,892", trend = "+18.4%") {
  group {
    rect {
      size: 320px 180px;
      fill: >cardSurface;
      stroke: >borderSubtle 1px solid;
      border-radius: >radiusLg;
      shadow: 0 12px 32px #00000040;
    }

    text {
      content: >title;
      at: top-left of parent offset 24px 24px;
      font-family: >fontFamily;
      font-size: 14px;
      font-weight: 500;
      color: >textMuted;
    }

    text {
      content: >value;
      at: top-left of parent offset 24px 60px;
      font-family: >fontFamily;
      font-size: 36px;
      font-weight: 800;
      color: >textLight;
    }

    StatusBadge {
      at: top-left of parent offset 24px 124px;
      label: >trend;
      bg: #10b98125;
      textColor: #34d399;
    }
  }
}

// -------------------------------------------------------------
// 3. CANVAS LAYOUT
// -------------------------------------------------------------
canvas "UI Kit Showcase" {
  width: 1200px;
  height: 800px;
  background: >bgDark;
  font-family: >fontFamily;
}

// Header Section
text #kitTitle {
  at: top-left of canvas offset 80px 60px;
  content: "Design System UI Components";
  font-family: >fontFamily;
  font-size: 36px;
  font-weight: 800;
  color: >textLight;
}

text #kitSubtitle {
  at: below #kitTitle offset 12px;
  content: "Production-ready, reusable atomic UI elements built with the TOAD DSL.";
  font-family: >fontFamily;
  font-size: 16px;
  font-weight: 400;
  color: >textMuted;
}

// Metric Cards Row
group #cardsRow {
  at: below #kitSubtitle offset 48px;

  MetricCard #card1 {
    title: "Monthly Recurring Revenue";
    value: "$148,290";
    trend: "+24.8%";
  }

  MetricCard #card2 {
    at: right of #card1 offset 24px;
    title: "Global Active Sessions";
    value: "892,104";
    trend: "+12.1%";
  }

  MetricCard #card3 {
    at: right of #card2 offset 24px;
    title: "Conversion Velocity";
    value: "4.82%";
    trend: "+3.6%";
  }
}

// Action Buttons Section
group #buttonsSection {
  at: below #cardsRow offset 48px;

  text #btnSectionTitle {
    content: "Interactive Action Controls";
    font-family: >fontFamily;
    font-size: 20px;
    font-weight: 700;
    color: >textLight;
  }

  PrimaryButton #btnPrimary {
    at: below #btnSectionTitle offset 20px;
    label: "Deploy Pipeline";
    width: 180px;
  }

  SecondaryButton #btnSecondary {
    at: right of #btnPrimary offset 16px;
    label: "Documentation";
    width: 160px;
  }

  StatusBadge #badgeLive {
    at: right of #btnSecondary offset 24px;
    label: "SYSTEM ONLINE";
    bg: #10b981;
    textColor: #ffffff;
  }

  StatusBadge #badgeBeta {
    at: right of #badgeLive offset 12px;
    label: "v2.4 RELEASE";
    bg: #8b5cf6;
    textColor: #ffffff;
  }
}
