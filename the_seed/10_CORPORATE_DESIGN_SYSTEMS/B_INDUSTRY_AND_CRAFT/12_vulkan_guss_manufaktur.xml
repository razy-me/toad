  <design_tokens>
    <colors>
      <color token="moltenOrange" hex="#EA580C" role="Flüssiges Eisen, Glut" />
      <color token="castBlack" hex="#171717" role="Gussform-Schwarz" />
      <color token="bronzeGold" hex="#B45309" role="Bronze- und Messingakzent" />
      <color token="smokeGray" hex="#737373" role="Hilfstexte" />
    </colors>
    <typography>
      <primary_font>&quot;Anton&quot;, &quot;Roboto&quot;, sans-serif</primary_font>
      <h1 scale="Bold (900), 38px" />
      <body scale="Regular (400), 14px, Color #D4D4D4" />
    </typography>
    <geometry>
      <card_radius>2px</card_radius>
      <button_radius>0px</button_radius>
      <grid_gap>16px</grid_gap>
    </geometry>
    <shadows>
      <ambient>none</ambient>
    </shadows>
  </design_tokens>

  <brand_rules>
    <dos>
      <do>Glut-Orange (#EA580C) gegen tiefes Gusseisenschwarz kontrastieren.</do>
    </dos>
    <donts>
      <dont>Keine dünnen, fragilen Vektoren.</dont>
    </donts>
  </brand_rules>

  <toad_component_blueprint lang="toad"><![CDATA[
canvas {
  size: 920px 560px;
  fill: #171717;
  font-family: "Roboto, sans-serif";
}

>ember = #EA580C;
>iron = #262626;
>white = #FFFFFF;

rect #foundryPanel {
  at: center of canvas;
  size: 840px 460px;
  fill: >iron;
  stroke: >ember;
  stroke-width: 2px;
}

text #foundryTitle {
  at: top left of #foundryPanel offset 32px 32px;
  content: "VULKAN METALLGUSS // SMELTER v2";
  font-size: 15px;
  font-weight: 700;
  color: >ember;
}

text #heroGrade {
  at: below #foundryTitle offset 16px;
  content: "SPHÄROGUSS GGG-40 / GGG-60";
  font-size: 32px;
  font-weight: 700;
  color: >white;
}
  ]]></toad_component_blueprint>

