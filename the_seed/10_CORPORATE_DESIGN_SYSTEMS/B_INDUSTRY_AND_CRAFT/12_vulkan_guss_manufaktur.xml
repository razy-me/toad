<?xml version="1.0" encoding="UTF-8"?>
<corporate_design id="vulkan_guss_manufaktur" industry_domain="industry_and_craft" category="B_INDUSTRY_AND_CRAFT" version="1.0">
  <brand_meta>
    <company_name>Vulkan Eisen- &amp; Bronzeguss</company_name>
    <product_name>Vulkan Industrie-Armaturen &amp; Spezialguss</product_name>
    <industry>Gießerei &amp; Metallurgische Fertigung</industry>
    <profile>Foundry for heat-resistant specialty alloys, marine propellers, and pump housings.</profile>
    <tone_of_voice>Feurig, kraftvoll, metallurgisch exakt, unverwüstlich.</tone_of_voice>
  </brand_meta>

  <tags>
    <tag>giesserei</tag>
    <tag>metall</tag>
