<?xml version="1.0" encoding="UTF-8"?>
<corporate_design id="bionova_genomics" industry_domain="health_and_life_sciences" category="C_HEALTH_AND_LIFE_SCIENCES" version="1.0">
  <brand_meta>
    <company_name>BioNova Genomics AG</company_name>
    <product_name>Sequenzierplattform NovaGene</product_name>
    <industry>Biotechnologie &amp; DNA-Sequenzierung</industry>
    <profile>Entwicklung von RNA-Therapeutika und hochpräziser Genomanalyse.</profile>
    <tone_of_voice>Wissenschaftlich exakt, zukunftsweisend, forschungsbasiert.</tone_of_voice>
  </brand_meta>

  <tags>
    <tag>genomik</tag>
    <tag>biotech</tag>
    <tag>dna</tag>
    <tag>cyan-glow</tag>
    <tag>forschung</tag>
  </tags>

  <design_tokens>
    <colors>
      <color token="labDark" hex="#080F1D" role="Dunkler Labor-Hintergrund" />
      <color token="geneCyan" hex="#00F5D4" role="DNA-Stränge, Fluoreszenz" />
      <color token="rnaPurple" hex="#7B2CBF" role="RNA-Ketten" />
    </colors>
    <typography>
      <primary_font>&quot;Space Grotesk&quot;, sans-serif</primary_font>
      <h1 scale="Bold (700), 34px" />
      <body scale="Regular (400), 14px, Color #94A3B8" />
    </typography>
    <geometry>
      <card_radius>12px</card_radius>
      <button_radius>6px</button_radius>
      <grid_gap>20px</grid_gap>
    </geometry>
    <shadows>
      <ambient>Fluoreszierender Glow</ambient>
    </shadows>
  </design_tokens>

  <brand_rules>
    <dos>
      <do>Fluoreszierendes Genom-Cyan (#00F5D4) als Lichtsignal nutzen.</do>
    </dos>
    <donts>
      <dont>Keine ungenauen Molekül-Darstellungen.</dont>
    </donts>
  </brand_rules>

  <toad_component_blueprint lang="toad"><![CDATA[
canvas {
  size: 920px 580px;
  fill: #080F1D;
  font-family: "Space Grotesk, sans-serif";
}

>cyan = #00F5D4;
>white = #FFFFFF;

rect #genePanel {
  at: center of canvas;
  size: 840px 480px;
  fill: #0F172A;
  stroke: >cyan;
  stroke-width: 1px;
  radius: 12px;
}

text #geneHeader {
  at: top left of #genePanel offset 36px 36px;
  content: "BIONOVA // NEXT-GEN GENOME SEQUENCING";
  font-size: 13px;
  font-weight: 700;
  color: >cyan;
}

text #seqTitle {
  at: below #geneHeader offset 16px;
  content: "NovaGene-X: 100 Mio. Reads pro Lauf";
  font-size: 30px;
  font-weight: 700;
  color: >white;
}
  ]]></toad_component_blueprint>

  <routing_triggers>
    <trigger>biotech styleguide</trigger>
    <trigger>genomics corporate design</trigger>
    <trigger>dna lab visual identity</trigger>
    <trigger>bionova</trigger>
    <trigger>scientific research flyer</trigger>
  </routing_triggers>
</corporate_design>
