<?xml version="1.0" encoding="UTF-8"?>
<corporate_design id="sanitas_apotheke" industry_domain="health_and_life_sciences" category="C_HEALTH_AND_LIFE_SCIENCES" version="1.0">
  <brand_meta>
    <company_name>Sanitas Apothekenverbund</company_name>
    <product_name>Sanitas Express-Botendienst</product_name>
    <industry>Pharmazie / Apotheke</industry>
    <profile>Apotheken vor Ort mit digitaler Vorbestellung und emissionsfreier E-Bike-Lieferung am selben Tag.</profile>
    <tone_of_voice>Verlässlich, pharmazeutisch beratungskompetent, nah, hilfsbereit.</tone_of_voice>
  </brand_meta>

  <tags>
    <tag>apotheke</tag>
    <tag>pharmazie</tag>
    <tag>rot-gruen</tag>
    <tag>botendienst</tag>
    <tag>beratung</tag>
  </tags>

  <design_tokens>
    <colors>
      <color token="apothekenRed" hex="#DC2626" role="Traditionelles Apotheken-Rot" />
      <color token="botanicalGreen" hex="#15803D" role="Pflanzenheilkunde &amp; Gesundheit" />
      <color token="pureWhite" hex="#FFFFFF" role="Hintergrund" />
    </colors>
    <typography>
      <primary_font>&quot;Inter&quot;, sans-serif</primary_font>
      <h1 scale="Bold (700), 32px" />
      <body scale="Regular (400), 14px, Color #1F2937" />
    </typography>
    <geometry>
      <card_radius>12px</card_radius>
      <button_radius>9999px</button_radius>
      <grid_gap>16px</grid_gap>
    </geometry>
    <shadows>
      <ambient>none</ambient>
    </shadows>
  </design_tokens>

  <brand_rules>
    <dos>
      <do>Apotheken-Rot mit beruhigendem Pflanzengrün (#15803D) abfedern.</do>
    </dos>
    <donts>
      <dont>Keine ungesicherten Arzneimittel-Werbeversprechen.</dont>
    </donts>
  </brand_rules>

  <toad_component_blueprint lang="toad"><![CDATA[
canvas {
  size: 880px 560px;
  fill: #F9FAFB;
  font-family: "Inter, sans-serif";
}

>red = #DC2626;
>green = #15803D;

rect #apoCard {
  at: center of canvas;
  size: 800px 460px;
  fill: #FFFFFF;
  stroke: #E5E7EB;
  stroke-width: 1px;
  radius: 12px;
}

text #apoHeader {
  at: top left of #apoCard offset 36px 36px;
  content: "SANITAS APOTHEKE // LOKAL & DIGITAL";
  font-size: 13px;
  font-weight: 700;
  color: >red;
}

text #apoTitle {
  at: below #apoHeader offset 14px;
  content: "Medikamente heute bestellt – heute geliefert";
  font-size: 28px;
  font-weight: 700;
  color: >green;
}
  ]]></toad_component_blueprint>

  <routing_triggers>
    <trigger>pharmacy styleguide</trigger>
    <trigger>apotheke corporate brand</trigger>
    <trigger>medicine delivery poster</trigger>
    <trigger>sanitas</trigger>
    <trigger>pharmaceutical brochure</trigger>
  </routing_triggers>
</corporate_design>
