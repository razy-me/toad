  <toad_component_blueprint lang="toad"><![CDATA[
canvas {
  size: 900px 580px;
  fill: #F3F4F6;
  font-family: "Montserrat, sans-serif";
}

>navy = #0F172A;
>red = #EF4444;

rect #seafoodCard {
  at: center of canvas;
  size: 800px 480px;
  fill: #FFFFFF;
  stroke: >navy;
  stroke-width: 2px;
  radius: 8px;
}

text #fishHeader {
  at: top left of #seafoodCard offset 40px 40px;
  content: "FISCHERHÜS SYLT // TAGESFANG VOM KUTTER";
  font-size: 13px;
  font-weight: 800;
  color: >red;
}

text #fishTitle {
  at: below #fishHeader offset 16px;
  content: "Büsumer Krabben & Frische Sylter Royal";
  font-size: 30px;
  font-weight: 800;
  color: >navy;
}
  ]]></toad_component_blueprint>

