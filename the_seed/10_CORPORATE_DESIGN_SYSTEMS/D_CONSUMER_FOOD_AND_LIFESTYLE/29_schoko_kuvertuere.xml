<?xml version="1.0" encoding="UTF-8"?>
<corporate_design id="schoko_kuvertuere" industry_domain="consumer_food_and_lifestyle" category="D_CONSUMER_FOOD_AND_LIFESTYLE" version="1.0">
  <brand_meta>
    <company_name>Chocolat Grand Cru Suisse</company_name>
    <product_name>74% Criollo Single Origin Tafel</product_name>
    <industry>Feinkost / Schokolade</industry>
    <profile>Traditionelle Schweizer Bean-to-Bar Manufaktur mit 72 Stunden Conchierzeit.</profile>
    <tone_of_voice>Verführerisch, cremig, exklusiv, meisterhaft conchiert.</tone_of_voice>
  </brand_meta>

  <tags>
    <tag>schokolade</tag>
    <tag>luxury-food</tag>
    <tag>cacao-brown</tag>
    <tag>gold</tag>
    <tag>swiss</tag>
  </tags>

  <design_tokens>
    <colors>
      <color token="cacaoDark" hex="#26130B" role="74% Edelkakao" />
      <color token="swissGold" hex="#D4AF37" role="Goldfolien-Prägung" />
      <color token="milkCream" hex="#FAF5EE" role="Cremiges Feinpapier" />
    </colors>
    <typography>
      <primary_font>&quot;Cormorant Garamond&quot;, serif</primary_font>
      <h1 scale="Semi-Bold (600), 36px" />
      <body scale="Regular (400), 14px, Color #26130B" />
    </typography>
    <geometry>
      <card_radius>4px</card_radius>
      <button_radius>2px</button_radius>
      <grid_gap>20px</grid_gap>
    </geometry>
    <shadows>
      <ambient>none</ambient>
    </shadows>
  </design_tokens>

  <brand_rules>
    <dos>
      <do>Tiefbrauner Kakao (#26130B) mit edler Goldprägung (#D4AF37).</do>
    </dos>
    <donts>
      <dont>Keine knallbunten Kinder-Süßigkeiten-Farben.</dont>
    </donts>
  </brand_rules>

  <toad_component_blueprint lang="toad"><![CDATA[
canvas {
  size: 880px 580px;
  fill: #26130B;
  font-family: "Cormorant Garamond, serif";
}

>cacao = #26130B;
>gold = #D4AF37;
>cream = #FAF5EE;

rect #chocCard {
  at: center of canvas;
  size: 780px 480px;
  fill: >cream;
  stroke: >gold;
  stroke-width: 2px;
  radius: 4px;
}

text #chocHeader {
  at: top center of #chocCard offset 0px 40px;
  content: "CHOCOLATIER GRAND CRU • GENÈVE";
  font-size: 15px;
  font-weight: 600;
  color: >gold;
}

text #chocTitle {
  at: below #chocHeader offset 16px;
  content: "Criollo 74% • 72h Conchiert";
  font-size: 32px;
  font-weight: 700;
  color: >cacao;
}
  ]]></toad_component_blueprint>

  <routing_triggers>
    <trigger>swiss chocolate packaging</trigger>
    <trigger>artisan bean to bar brand</trigger>
    <trigger>luxury cacao styleguide</trigger>
    <trigger>chocolat grand cru</trigger>
    <trigger>confectionery gift card</trigger>
  </routing_triggers>
</corporate_design>
