  <toad_component_blueprint lang="toad"><![CDATA[
canvas {
  size: 880px 580px;
  fill: #0F172A;
  font-family: "Bodoni MT, serif";
}

>navy = #1E293B;
>burgundy = #831843;
>white = #F8FAFC;

rect #tailorCard {
  at: center of canvas;
  size: 780px 480px;
  fill: >navy;
  stroke: >burgundy;
  stroke-width: 2px;
  radius: 2px;
}

text #tailorHeader {
  at: top center of #tailorCard offset 0px 40px;
  content: "SARTORIA MARCHESE • NAPOLI DAL 1928";
  font-size: 15px;
  font-weight: 600;
  color: >burgundy;
}

text #suitTitle {
  at: below #tailorHeader offset 16px;
  content: "Bespoke Su Misura • Spalla Camicia";
  font-size: 32px;
  font-weight: 700;
  color: >white;
}
  ]]></toad_component_blueprint>

