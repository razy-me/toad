<?xml version="1.0" encoding="UTF-8"?>
<corporate_design id="monolith_yachting" industry_domain="luxury_and_fashion" category="E_LUXURY_AND_FASHION" version="1.0">
  <brand_meta>
    <company_name>Monolith Superyachts</company_name>
    <product_name>90m Explorer Yacht Projekt Orca</product_name>
    <industry>Marine / Superyacht-Werft</industry>
    <profile>Custom-Superyachten mit Hybridantrieb, Eisklasse-Rumpf und transozeanischer Reichweite.</profile>
    <tone_of_voice>Ehrfurchtgebietend, luxuriös, nautisch kühn, bahnbrechend.</tone_of_voice>
  </brand_meta>

  <tags>
    <tag>superyacht</tag>
    <tag>werft</tag>
    <tag>ozeanblau</tag>
    <tag>monaco</tag>
    <tag>marina</tag>
  </tags>

  <design_tokens>
    <colors>
      <color token="abyssDark" hex="#030712" role="Tiefsee-Schwarzblau" />
      <color token="teakGold" hex="#B45309" role="Teakholz-Deck" />
      <color token="iceHull" hex="#F8FAFC" role="Stahlrumpf-Weiß" />
    </colors>
    <typography>
      <primary_font>&quot;Space Grotesk&quot;, sans-serif</primary_font>
      <h1 scale="Bold (700), 38px" />
      <body scale="Regular (400), 14px, Color #94A3B8" />
    </typography>
    <geometry>
      <card_radius>4px</card_radius>
      <button_radius>2px</button_radius>
      <grid_gap>24px</grid_gap>
    </geometry>
    <shadows>
      <ambient>Wasserspiegelung</ambient>
    </shadows>
  </design_tokens>

  <brand_rules>
    <dos>
      <do>Dunkelste Tiefsee-Farben mit feinen Teak-Akzenten (#B45309).</do>
    </dos>
    <donts>
      <dont>Keine billigen Spielzeugboot-Grafiken.</dont>
    </donts>
  </brand_rules>

  <toad_component_blueprint lang="toad"><![CDATA[
canvas {
  size: 920px 580px;
  fill: #030712;
  font-family: "Space Grotesk, sans-serif";
}

>teak = #B45309;
>white = #F8FAFC;

rect #yachtPanel {
  at: center of canvas;
  size: 840px 480px;
  fill: #0B1329;
  stroke: >teak;
  stroke-width: 1px;
  radius: 4px;
}

text #yachtHeader {
  at: top left of #yachtPanel offset 36px 36px;
  content: "MONOLITH // MONACO YACHT SHOW PREVIEW";
  font-size: 13px;
  font-weight: 700;
  color: >teak;
}

text #yachtTitle {
  at: below #yachtHeader offset 16px;
  content: "90m Hybrid Explorer Yacht 'ORCA I'";
  font-size: 32px;
  font-weight: 700;
  color: >white;
}
  ]]></toad_component_blueprint>

  <routing_triggers>
    <trigger>superyacht brand</trigger>
    <trigger>luxury marine styleguide</trigger>
    <trigger>monaco yachting poster</trigger>
    <trigger>monolith yachts</trigger>
    <trigger>naval architecture brochure</trigger>
  </routing_triggers>
</corporate_design>
