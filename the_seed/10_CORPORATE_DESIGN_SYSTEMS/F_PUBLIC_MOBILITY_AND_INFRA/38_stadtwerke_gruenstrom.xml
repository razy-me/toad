<?xml version="1.0" encoding="UTF-8"?>
<corporate_design id="stadtwerke_gruenstrom" industry_domain="public_mobility_and_infra" category="F_PUBLIC_MOBILITY_AND_INFRA" version="1.0">
  <brand_meta>
    <company_name>Stadtwerke GrünStrom</company_name>
    <product_name>100% Regionale Geothermie &amp; Windkraft</product_name>
    <industry>Öffentliche Infrastruktur / Kommunale Energie</industry>
    <profile>Municipal utility provider supplying district heating, hydrogen networks, and clean renewable power.</profile>
    <tone_of_voice>Gemeinwohlorientiert, bürgernah, zukunftssicher, verlässlich.</tone_of_voice>
  </brand_meta>

  <tags>
    <tag>stadtwerke</tag>
    <tag>energie</tag>
    <tag>gruen</tag>
    <tag>geothermie</tag>
    <tag>kommunal</tag>
  </tags>

  <design_tokens>
    <colors>
      <color token="greenPower" hex="#16A34A" role="Erneuerbare Energie" />
      <color token="waterCyan" hex="#0284C7" role="Kommunales Trinkwasser" />
      <color token="slateCity" hex="#1E293B" role="Headlines" />
    </colors>
    <typography>
      <primary_font>&quot;Inter&quot;, sans-serif</primary_font>
      <h1 scale="Bold (700), 34px" />
      <body scale="Regular (400), 15px, Color #334155" />
    </typography>
    <geometry>
      <card_radius>12px</card_radius>
      <button_radius>6px</button_radius>
      <grid_gap>20px</grid_gap>
    </geometry>
    <shadows>
      <ambient>none</ambient>
    </shadows>
  </design_tokens>

  <brand_rules>
    <dos>
      <do>Signalstarkes Grün (#16A34A) mit Trinkwasser-Blau (#0284C7) verbinden.</do>
    </dos>
    <donts>
      <dont>Keine unklaren CO2-Greenwashing-Grafiken.</dont>
    </donts>
  </brand_rules>

  <toad_component_blueprint lang="toad"><![CDATA[
canvas {
  size: 900px 560px;
  fill: #F0FDF4;
  font-family: "Inter, sans-serif";
}

>green = #16A34A;
>slate = #1E293B;

rect #energyCard {
  at: center of canvas;
  size: 800px 460px;
  fill: #FFFFFF;
  stroke: >green;
  stroke-width: 1px;
  radius: 12px;
}

text #energyHeader {
  at: top left of #energyCard offset 36px 36px;
  content: "STADTWERKE GRÜNSTROM // REGIONALE WÄRMEWENDE";
  font-size: 13px;
  font-weight: 700;
  color: >green;
}

text #energyTitle {
  at: below #energyHeader offset 14px;
  content: "100% Green Energy & Deep Geothermal Power for all Citizens";
  font-size: 28px;
  font-weight: 700;
  color: >slate;
}
  ]]></toad_component_blueprint>

  <routing_triggers>
    <trigger>public utility styleguide</trigger>
    <trigger>municipal energy brand</trigger>
    <trigger>green power flyer</trigger>
    <trigger>stadtwerke</trigger>
    <trigger>clean energy banner</trigger>
  </routing_triggers>
</corporate_design>
