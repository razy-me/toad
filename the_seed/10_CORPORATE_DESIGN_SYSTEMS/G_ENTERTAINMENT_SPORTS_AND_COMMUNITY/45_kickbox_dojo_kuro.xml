<?xml version="1.0" encoding="UTF-8"?>
<corporate_design id="kickbox_dojo_kuro" industry_domain="entertainment_sports_and_community" category="G_ENTERTAINMENT_SPORTS_AND_COMMUNITY" version="1.0">
  <brand_meta>
    <company_name>Kuro Martial Arts Dojo</company_name>
    <product_name>Muay Thai &amp; K-1 Kampfsport-Akademie</product_name>
    <industry>Sport / Kampfsport</industry>
    <profile>Traditionelles Trainingszentrum für Disziplin, Boxen, Grappling und Wettkampfvorbereitung.</profile>
    <tone_of_voice>Respektvoll, diszipliniert, kraftvoll, unverwüstlich.</tone_of_voice>
  </brand_meta>

  <tags>
    <tag>kampfsport</tag>
    <tag>dojo</tag>
    <tag>schwarz-rot</tag>
    <tag>muay-thai</tag>
    <tag>disziplin</tag>
  </tags>

  <design_tokens>
    <colors>
      <color token="dojoBlack" hex="#0A0A0A" role="Tatami-Matten-Schwarz" />
      <color token="crimsonRed" hex="#DC2626" role="Rote Handschuhe, Zunftstreifen" />
      <color token="pureWhite" hex="#FFFFFF" role="Wandinschriften" />
    </colors>
    <typography>
      <primary_font>&quot;Impact&quot;, &quot;Inter&quot;, sans-serif</primary_font>
      <h1 scale="Bold (900), 38px" />
      <body scale="Regular (400), 14px, Color #D4D4D8" />
    </typography>
    <geometry>
      <card_radius>2px</card_radius>
      <button_radius>0px</button_radius>
      <grid_gap>16px</grid_gap>
    </geometry>
    <shadows>
      <ambient>none</ambient>
    </shadows>
  </design_tokens>

  <brand_rules>
    <dos>
      <do>Dojo-Schwarz (#0A0A0A) mit K-1 Kampfrot (#DC2626) kombinieren.</do>
    </dos>
    <donts>
      <dont>Keine weichen Pastellfarben.</dont>
    </donts>
  </brand_rules>

  <toad_component_blueprint lang="toad"><![CDATA[
canvas {
  size: 880px 580px;
  fill: #0A0A0A;
  font-family: "Impact, sans-serif";
}

>red = #DC2626;
>white = #FFFFFF;

rect #dojoPanel {
  at: center of canvas;
  size: 800px 480px;
  fill: #141414;
  stroke: >red;
  stroke-width: 3px;
}

text #dojoHeader {
  at: top left of #dojoPanel offset 36px 36px;
  content: "KURO MARTIAL ARTS // MUAY THAI & K-1";
  font-size: 16px;
  font-weight: 700;
  color: >red;
}

text #dojoTitle {
  at: below #dojoHeader offset 16px;
  content: "DISZIPLIN • KRAFT • RESPEKT";
  font-size: 38px;
  font-weight: 900;
  color: >white;
}
  ]]></toad_component_blueprint>

  <routing_triggers>
    <trigger>martial arts gym brand</trigger>
