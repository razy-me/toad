// ============================================================================
// TOAD DSL — OFFICIAL LOGO & BRAND ASSETS
// ============================================================================

>bg_void        = #07090e;
>bg_card        = #0f172a;
>emerald_primary = #10b981;
>toxic_lime     = #ccff00;
>cyber_cyan     = #38bdf8;
>text_pure      = #ffffff;
>text_muted     = #94a3b8;
>border_dark    = #1e293b;

// ----------------------------------------------------------------------------
// ARTBOARD 1: MASTER LOGO (Horizontal Lockup - Dark Theme)
// ----------------------------------------------------------------------------
canvas "Master-Logo" {
    size: 1200px 540px;
    background: >bg_void;
    export: all;

    // Bounding Box Layout Container
    stack #logoRoot {
        direction: horizontal;
        gap: 56px;
        size: hug hug;
        at: center of canvas;

        // --- CYBER-TOAD GEOMETRIC EMBLEM ---
        group #emblemContainer {
            size: 180px 180px;

            // Outer Glow & Squircle Base
            rect #emblemBase {
                size: 180px 180px;
                radius: 40px;
                fill: #0d1322;
                stroke: #1e293b 2px;
                shadow: 0px 20px 50px rgba(16, 185, 129, 0.25);
                at: (0px, 0px);
            }

            // Inner Ambient Neon Gradient Rim
            rect #emblemRim {
                size: 168px 168px;
                radius: 34px;
                fill: transparent;
                stroke: rgba(16, 185, 129, 0.4) 1.5px;
                at: center of #emblemBase;
            }

            // Toad Head Geometric Body
            rect #toadHead {
                size: 120px 76px;
                radius: 24px;
                fill: linear-gradient(135deg, #10b981 0%, #059669 100%);
                at: center of #emblemBase offset (0px, 14px);
            }

            // Left Optical Sensor Eye (Vertex Node)
            circle #leftEyeOuter {
                size: 42px;
                fill: #0d1322;
                stroke: #10b981 3px;
                at: center of #emblemBase offset (-32px, -24px);
            }

            circle #leftEyeCore {
                size: 20px;
                fill: >toxic_lime;
                at: center of #leftEyeOuter;
                shadow: 0px 0px 12px #ccff00;
            }

            // Right Optical Sensor Eye (Vertex Node)
            circle #rightEyeOuter {
                size: 42px;
                fill: #0d1322;
                stroke: #10b981 3px;
                at: center of #emblemBase offset (32px, -24px);
            }

            circle #rightEyeCore {
                size: 20px;
                fill: >toxic_lime;
                at: center of #rightEyeOuter;
                shadow: 0px 0px 12px #ccff00;
            }

            // Central Code Prompt Chevron ">_"
            text #promptGlyph {
                content: ">_";
                font-size: 22px;
                font-weight: 900;
                color: #07090e;
                at: center of #toadHead offset (0px, -2px);
            }

            // Dynamic Digital Mouth Line
            rect #mouthBeam {
                size: 54px 6px;
                radius: 3px;
                fill: #07090e;
                at: center of #toadHead offset (0px, 18px);
            }
        }

        // --- TYPOGRAPHIC WORDMARK & METADATA ---
        stack #textBlock {
            direction: vertical;
            gap: 12px;
            size: hug hug;

            // Version & Technology Badge
            stack #metaBadge {
                direction: horizontal;
                padding: [4px, 12px, 4px, 12px];
                radius: 8px;
                fill: rgba(16, 185, 129, 0.12);
                stroke: rgba(16, 185, 129, 0.3) 1px;
                size: hug hug;

                text #badgeText {
                    content: "SPATIAL DESIGN DSL • v2.4";
                    font-size: 11px;
                    font-weight: 700;
                    color: >emerald_primary;
                    letter-spacing: 2px;
                }
            }

            // Primary Wordmark "toad.dsl"
            stack #wordmarkRow {
                direction: horizontal;
                gap: 2px;

                text #brandName {
                    content: "toad";
                    font-size: 78px;
                    font-weight: 900;
                    color: >text_pure;
                    letter-spacing: -2px;
                }

                text #extensionTag {
                    content: ".dsl";
                    font-size: 36px;
                    font-weight: 800;
                    color: >emerald_primary;
                    at: right of #brandName offset (2px, 28px);
                }
            }

            // Brand Slogan
            text #brandClaim {
                content: "CODE YOUR CANVAS.";
                font-size: 14px;
                font-weight: 700;
                color: >text_muted;
                letter-spacing: 5px;
            }
        }
    }
}

// ----------------------------------------------------------------------------
// ARTBOARD 2: STANDALONE APP ICON / SQUIRCLE SIGNET (512x512)
// ----------------------------------------------------------------------------
canvas "App-Icon" {
    size: 512px 512px;
    background: >bg_void;
    export: all;

    group #appIconRoot {
        size: 440px 440px;
        at: center of canvas;

        // Outer Heavy Obsidian Squircle
        rect #appBase {
            size: 440px 440px;
            radius: 96px;
            fill: #0c1220;
            stroke: #1e293b 3px;
            shadow: 0px 30px 80px rgba(16, 185, 129, 0.35);
            at: (0px, 0px);
        }

        // Neon Accent Border Rim
        rect #appRim {
            size: 416px 416px;
            radius: 84px;
            fill: transparent;
            stroke: rgba(16, 185, 129, 0.5) 2px;
            at: center of #appBase;
        }

        // Toad Head Structure
        rect #appToadHead {
            size: 280px 180px;
            radius: 56px;
            fill: linear-gradient(135deg, #10b981 0%, #059669 100%);
            at: center of #appBase offset (0px, 36px);
            shadow: 0px 15px 35px rgba(0, 0, 0, 0.5);
        }

        // Left Giant Optical Sensor Eye
        circle #appEyeLeftOuter {
            size: 100px;
            fill: #0c1220;
            stroke: #10b981 7px;
            at: center of #appBase offset (-74px, -52px);
        }

        circle #appEyeLeftCore {
            size: 48px;
            fill: >toxic_lime;
            at: center of #appEyeLeftOuter;
            shadow: 0px 0px 24px #ccff00;
        }

        // Right Giant Optical Sensor Eye
        circle #appEyeRightOuter {
            size: 100px;
            fill: #0c1220;
            stroke: #10b981 7px;
            at: center of #appBase offset (74px, -52px);
        }

        circle #appEyeRightCore {
            size: 48px;
            fill: >toxic_lime;
            at: center of #appEyeRightOuter;
            shadow: 0px 0px 24px #ccff00;
        }

        // Prompt Chevron in Center
        text #appPrompt {
            content: ">_";
            font-size: 52px;
            font-weight: 900;
            color: #07090e;
            at: center of #appToadHead offset (0px, -6px);
        }

        // Mouth Slit / Data Bus
        rect #appMouth {
            size: 130px 14px;
            radius: 7px;
            fill: #07090e;
            at: center of #appToadHead offset (0px, 42px);
        }
    }
}
